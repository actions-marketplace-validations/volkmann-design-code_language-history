{
  "name": "language-history",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "language-history": "bun apps/cli/src/cli.ts",
    "examples": "bun apps/examples/src/examples.ts",
    "linguist-colors": "bun libs/chart/scripts/linguist-colors.ts",
    "check": "biome check .",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test:unit"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "1.3.14",
    "lefthook": "2.2.2",
    "nx": "22.7.12",
    "typescript": "6.0.3"
  }
}
