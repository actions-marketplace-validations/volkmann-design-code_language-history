{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "pluginsConfig": {
    "@nx/js": {
      "analyzeLockfile": false
    }
  },
  "targetDefaults": {
    "typecheck": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --rootDir . -p {projectRoot}/tsconfig.json"
      },
      "inputs": ["default", "^default", "{workspaceRoot}/tsconfig.json"]
    },
    "test:unit": {
      "cache": true
    }
  },
  "affected": {
    "defaultBase": "main"
  }
}
